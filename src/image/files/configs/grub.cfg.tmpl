# UEFI GRUB configuration embedded into BOOTX64.EFI together with the kernel.
# GRUB must not read anything from disk: the boot partition is not covered by
# measurements, and any config, module or filesystem parsed from it would run
# before the kernel is measured.
set timeout=0
set timeout_style=hidden
set root=memdisk

# The menu entry boots without a password; the console and entry editing need
# a superuser. The hash is random data with no known password, so the console
# stays locked and the image stays reproducible.
set superusers="sp-vm"
password_pbkdf2 sp-vm $GRUB_PASSWORD_PBKDF2

menuentry 'SP Linux' --unrestricted {
    linux /boot/$KERNEL_FILENAME $KERNEL_CMDLINE
}
