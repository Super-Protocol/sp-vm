[Unit]
Description=PKI VM mode detector service
After=network-online.target
Wants=network-online.target
# SUP-375: retry forever, but never faster than RestartSec.
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
# SUP-375: one bounded attempt per start. The ExecStartPre used to be
# `until [[ -s /sp/swarm/config.yaml ]]; do sleep 5; done` under
# TimeoutStartSec=infinity, so when provider-config.service could not populate
# /sp - the SUP-343 blob-expiry case - THIS unit was the one that held
# multi-user.target forever, even though provider-config.service itself already
# fails on its own with Restart=on-failure.
#
# The wait is bounded inside pki-vm-mode.sh (120s) rather than removed: /sp
# normally lands within seconds, and failing on the first missing read would
# turn an ordinary ordering race into a console block on every boot. The limit
# below covers the whole start phase - the runner's 180s cap plus up to 10s of
# SIGKILL grace, and ExecStartPost - which leaves ~50s of headroom.
TimeoutStartSec=240
Restart=on-failure
RestartSec=30
ExecStart=/usr/local/bin/sp-boot-attempt.sh \
    --unit pki-vm-mode.service \
    --timeout 180 \
    --action "VM mode detection from /sp/swarm/config.yaml" \
    --impact "/etc/swarm/swarm-vm-mode is unset, so neither pki-cert-init nor" \
    --impact "pki-authority-sync can tell whether this node is a seed or a worker." \
    --detail "config:    /sp/swarm/config.yaml (populated by provider-config.service)" \
    --detail "output:    /etc/swarm/swarm-vm-mode" \
    -- /usr/local/bin/pki-vm-mode.sh
# Both of these died with JOB_DEPENDENCY when the boot-time attempt failed, and
# Restart= cannot help a unit whose start job never ran. Each one revives the
# chain behind it through its own ExecStartPost; the ExecCondition on each makes
# the one that does not apply to this node a no-op.
ExecStartPost=-/usr/bin/systemctl --no-block start pki-cert-init.service pki-authority-sync.service

[Install]
WantedBy=multi-user.target
