#!/bin/bash

# SUP-376: the positive witness that this node is actually serving.
#
# Every other publisher under /run/sp-health reports a GATE - something that
# must not have failed. No gate, and no combination of gates, is evidence that
# the node serves: `pki-authority-sync` can report ok while swarm-node is down,
# and a departed node's gates all stay ok forever (SUP-308/331). The rollup's
# `serving` verdict is therefore reachable only through this unit, which is why
# the CTO's ruling - "a route may be written only from positive evidence of
# serving, and absence of evidence is an error, not a fallback" - has somewhere
# to stand.
#
# It probes from loopback exactly what the host probes from outside:
#
#   1. https://127.0.0.1:9443/api/v1/pki/certs/ca returns a PEM. Unauthenticated
#      and the same call as cluster.sh's fetch_ca, so it answers only once
#      pki-cert-init, pki-authority-sync and the PKI service have all finished;
#   2. http://127.0.0.1:4001/nodes is 2xx and lists this node - the same payload
#      and the same match as spvm_cloud.py's parse_membership, so it answers only
#      once swarm-db, swarm-host-agent and swarm-node are up and gossip has
#      converged.
#
# It publishes TWO BOOLEANS AND ONE STATUS WORD FROM A CLOSED SET, and nothing
# else: no names, no IPs, no member list. The node name is used to MATCH inside
# this script and never leaves it. :9180 is plain HTTP on an unauthenticated
# port with no source restriction (hardening-vm.sh), so the whole membership
# list would be free reconnaissance, and this record would be the only place on
# the surface that carried one.

set -uo pipefail

readonly unit_name="node-serving.service"
readonly publish="${SP_HEALTH_PUBLISH:-/usr/local/bin/sp-health-publish}"
readonly state_dir="${SP_HEALTH_STATE_DIR:-/run/sp-health}"
# Scratch state, NOT in the records directory: /run/sp-health holds records only
# (one *.json per unit), because the endpoint enumerates it on an
# unauthenticated port and every non-record file in it is one filter bug away
# from being served. Still under /run, so it is still per-boot.
readonly runtime_dir="${SP_NODE_SERVING_RUNTIME_DIR:-/run/sp-node-serving}"
readonly first_run_file="${runtime_dir}/first-run"

readonly curl_cmd="${SP_CURL:-/usr/bin/curl}"
readonly pki_url="${SP_NODE_SERVING_PKI_URL:-https://127.0.0.1:9443/api/v1/pki/certs/ca}"
readonly node_api_url="${SP_NODE_SERVING_NODE_API_URL:-http://127.0.0.1:4001/nodes}"
readonly swarm_db_config="${SP_NODE_SERVING_SWARM_DB_CONFIG:-/etc/swarm-db/config.yaml}"

# Each probe is bounded hard. The timer's own interval is the budget for the
# pair, and a probe that outlives it would push the record past its ttl_sec and
# make a serving node read as stale.
readonly connect_timeout="${SP_NODE_SERVING_CONNECT_TIMEOUT:-2}"
readonly max_time="${SP_NODE_SERVING_MAX_TIME:-5}"

# Twice the timer's interval, per the convention for a REPEATING publisher: the
# ttl bounds the gap between writes, not the length of one attempt. Keep in sync
# with OnUnitActiveSec in sp-node-serving.timer.
readonly timer_interval="${SP_NODE_SERVING_TIMER_INTERVAL:-30}"
readonly ttl_sec="${SP_NODE_SERVING_TTL_SEC:-$((timer_interval * 2))}"

# How long the node may legitimately take to reach `serving` before this stops
# saying "not yet" and says "something is wrong". See the unit file for the
# arithmetic behind 1800s.
readonly serving_budget="${SP_NODE_SERVING_BUDGET:-1800}"

# Never terminal. This unit is a witness, not an authority on impossibility: a
# node can start serving at any later point, and the moment both probes pass
# this record flips back to ok. The verdicts that end a wait come from the gates
# that know they cannot be retried.
publish_state() {
    local state="$1" reason_class="$2" reason="$3" ca_ok="$4" membership_ok="$5"
    "$publish" \
        --unit "$unit_name" \
        --state "$state" \
        --reason-class "$reason_class" \
        --reason "$reason" \
        --ttl-sec "$ttl_sec" \
        --gate true \
        --terminal false \
        --bool "ca_ok=$ca_ok" \
        --bool "membership_ok=$membership_ok" \
        || echo "[sp-node-serving-probe] ERROR: could not publish health state" >&2
}

# node.name from the generated swarm-db config, which is the name swarm-db
# gossips and therefore the name /nodes reports. Falls back to the hostname,
# which is what generate-swarm-db-config.sh itself defaults to.
node_name() {
    local name=""
    if [[ -r "$swarm_db_config" ]]; then
        name="$(sed -n '/^node:/,/^[^[:space:]]/ s/^[[:space:]]\+name:[[:space:]]*//p' \
            "$swarm_db_config" 2>/dev/null | head -n1)"
        name="${name%\"}"; name="${name#\"}"
        name="${name%\'}"; name="${name#\'}"
    fi
    [[ -n "$name" ]] || name="$(hostname 2>/dev/null || true)"
    printf '%s' "$name"
}

probe_ca() {
    local body
    # -k: the CA is served under the swarm's own chain, which this node may not
    # trust yet - and the probe is about whether :9443 SERVES a CA, not about
    # verifying it. fetch_ca makes the same call the same way (cluster.sh:137).
    body="$("$curl_cmd" -kfsS \
        --connect-timeout "$connect_timeout" --max-time "$max_time" \
        "$pki_url" 2>/dev/null)" || return 1
    [[ "$body" == *"-----BEGIN CERTIFICATE-----"* ]] || return 1
    return 0
}

probe_membership() {
    local name body pattern
    name="$(node_name)"
    [[ -n "$name" ]] || return 1
    body="$("$curl_cmd" -fsS \
        --connect-timeout "$connect_timeout" --max-time "$max_time" \
        "$node_api_url" 2>/dev/null)" || return 1
    # The same match as parse_membership: node_id or node_name, plus the `id`
    # alias the API adds. Whitespace after the colon is tolerated because the
    # match must not depend on the serialiser staying compact.
    pattern="\"(node_id|node_name|id)\"[[:space:]]*:[[:space:]]*\"$(printf '%s' "$name" | sed 's/[][\\.^$*+?(){}|/]/\\&/g')\""
    grep -qE "$pattern" <<<"$body" || return 1
    return 0
}

install -d -m 0755 "$state_dir" 2>/dev/null || true
install -d -m 0755 "$runtime_dir" 2>/dev/null || true

now="$(date -u '+%s')"

# The sentinel is the ONLY thing that makes the budget advance, so it is
# validated by CONTENT and rewritten whenever the content is unusable. Testing
# existence instead was a latent zero-budget bug: an empty or non-numeric
# sentinel left first_run at `now` on every single run, so elapsed was 0 for
# the life of the boot and `failed` could never be reached - the record stayed
# `attempting`, was rewritten every 30s and therefore always fresh, and the
# rollup read `booting` forever. SUP-370's never-clearing condition, reproduced
# at the reporting layer by the code meant to report it. A truncated file is
# not hypothetical: the write below truncates before it writes, so a kill or a
# full tmpfs in between leaves exactly that.
#
# /run is tmpfs, so a valid sentinel is always the first run SINCE BOOT, which
# is what the budget has to be measured from. A reboot restarts the clock, and
# should.
first_run=""
if [[ -r "$first_run_file" ]]; then
    # Whitespace stripped, nothing else: `tr -cd '[:digit:]'` would launder
    # "12x34" into the plausible-looking epoch 1234, accepting garbage instead
    # of repairing it.
    recorded="$(tr -d '[:space:]' <"$first_run_file" 2>/dev/null)"
    # A sentinel AHEAD of now cannot be a first-run time. chrony steps the
    # clock during boot, so this is the ordinary case rather than a corruption:
    # restarting the budget is right, freezing it at zero is not.
    if [[ "$recorded" =~ ^[0-9]+$ ]] && (( recorded <= now )); then
        first_run="$recorded"
    fi
fi
if [[ -z "$first_run" ]]; then
    first_run="$now"
    printf '%s\n' "$first_run" >"$first_run_file" 2>/dev/null || true
fi
elapsed=$((now - first_run))

ca_ok=false
membership_ok=false
probe_ca && ca_ok=true
probe_membership && membership_ok=true

if [[ "$ca_ok" == true && "$membership_ok" == true ]]; then
    publish_state ok serving \
        "this node serves: the local PKI service returns a CA and swarm membership lists it" \
        true true
    exit 0
fi

if [[ "$ca_ok" == false && "$membership_ok" == false ]]; then
    reason_class="no-local-evidence"
    reason="neither the local PKI service nor swarm membership shows this node serving"
elif [[ "$ca_ok" == false ]]; then
    reason_class="ca-unavailable"
    reason="swarm membership lists this node, but the local PKI service is not serving a CA"
else
    reason_class="membership-absent"
    reason="the local PKI service serves a CA, but swarm membership does not list this node"
fi

if (( elapsed > serving_budget )); then
    publish_state failed "$reason_class" \
        "${reason} after ${elapsed}s" "$ca_ok" "$membership_ok"
    # Exit 0 regardless: the timer's job is to keep publishing, and a failed
    # unit would stop systemd restarting the service behind it. The verdict is
    # in the record, which is the channel that leaves the node.
    exit 0
fi

publish_state attempting "$reason_class" \
    "${reason}; still within the ${serving_budget}s bring-up budget at ${elapsed}s" \
    "$ca_ok" "$membership_ok"
exit 0
